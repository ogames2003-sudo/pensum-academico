# Copia este archivo como .env.local y completa con los valores de TU proyecto Supabase
# (Supabase → Project Settings → API). Solo claves públicas: NUNCA la service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Opcional: slug del programa que se muestra en la vista pública (por defecto, el primero publicado).
VITE_PROGRAM_SLUG=
